{
  "name": "maiker-cli",
  "version": "0.1.0",
  "description": "mAIker — a local-first AI product engineering CLI",
  "type": "module",
  "bin": {
    "maiker": "./out/bin/maiker.js"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "dev": "tsx bin/maiker.ts",
    "start": "node out/bin/maiker.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf out || true",
    "prebuild": "npm run clean",
    "link:local": "npm run build && sudo npm link --ignore-scripts && sudo chown -R $(whoami) out/",
    "setup": "sudo ./scripts/bootstrap.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@google/generative-ai": "^0.24.1",
    "@langchain/core": "^0.3.0",
    "@langchain/langgraph": "^0.2.0",
    "@langchain/langgraph-checkpoint-sqlite": "~0.2.1",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.0",
    "fs-extra": "^11.2.0",
    "glob": "^11.0.0",
    "inquirer": "^10.1.0",
    "js-yaml": "^4.1.0",
    "openai": "^4.50.0",
    "ora": "^8.0.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.5.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ai",
    "cli",
    "automation",
    "code-generation",
    "playwright",
    "langgraph",
    "ai-agents"
  ],
  "license": "MIT"
}
